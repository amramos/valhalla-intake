{
  "description": "Shared project safeguards and validation for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" protect_paths.py",
            "commandWindows": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" protect_paths.py",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" guard_bash.py",
            "commandWindows": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" guard_bash.py",
            "timeout": 10,
            "statusMessage": "Checking shell safety"
          },
          {
            "type": "command",
            "command": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" pre_commit_lint.py",
            "commandWindows": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" pre_commit_lint.py",
            "timeout": 30,
            "statusMessage": "Checking pre-commit requirements"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" validate_gdscript.py",
            "commandWindows": "bash \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.agents/hooks/run.sh\" validate_gdscript.py",
            "timeout": 30,
            "statusMessage": "Validating touched GDScript"
          }
        ]
      }
    ]
  }
}
