{
  "enabledMcpjsonServers": [
    "godot"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/validate_gdscript.py\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Validating GDScript (gdformat/gdlint/godot --check-only)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/protect_paths.py\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for protected path..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/guard_bash.py\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for dangerous command..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/pre_commit_lint.py\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Linting before commit (gdformat/gdlint)..."
          }
        ]
      }
    ]
  }
}