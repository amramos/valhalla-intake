[sub_resource type="Resource" id="Resource_mentor1"]
script = ExtResource("4_mentor")
text = "Read him."

[sub_resource type="Resource" id="Resource_mentor2"]
script = ExtResource("4_mentor")
text = "No wound. 'Axed my chest.' Pin them."
highlight = Array[String](["B1", "C1"])
until = 1

[sub_resource type="Resource" id="Resource_mentor3"]
script = ExtResource("4_mentor")
text = "The body never lies. L2 takes liars."
door = &"hel"
until = 2

[resource]
script = ExtResource("2_5ourl")
id = &"kolbeinn"
soul_name = "Kolbeinn"
body = Array[ExtResource("1_7p4gq")]([SubResource("Resource_pse3c"), SubResource("Resource_pcpol"), SubResource("Resource_qw3tm"), SubResource("Resource_mrxxe")])
claim = Array[String](["Danes axed my chest.", "Mail on. Shield up.", "Died sword in hand.", "My wife will tell you."])
seams = Array[ExtResource("3_0oklw")]([SubResource("Resource_sqadd"), SubResource("Resource_41w6o"), SubResource("Resource_j5sqq"), SubResource("Resource_iglx7")])
legal_realm = &"hel"
worthy_realm = &"hel"
liar = true
mentor_steps = Array[ExtResource("4_mentor")]([SubResource("Resource_mentor1"), SubResource("Resource_mentor2"), SubResource("Resource_mentor3")])
truth = "Died in his bed after the feast, full of mead. His wife did see."
