[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://data/fact_data.gd" id="1_5ourl"]
[ext_resource type="Script" path="res://data/mentor_step_data.gd" id="2_0oklw"]
[ext_resource type="Script" path="res://data/encounter_data.gd" id="3_pse3c"]
[ext_resource type="Script" path="res://data/seam_data.gd" id="4_pcpol"]

[sub_resource type="Resource" id="fact_B1"]
script = ExtResource("1_5ourl")
id = "B1"
label = "no wound, chest"
view = &"front"
place = &"torso_front"

[sub_resource type="Resource" id="fact_B2"]
script = ExtResource("1_5ourl")
id = "B2"
label = "no wound, back"
view = &"back"
place = &"torso_back"

[sub_resource type="Resource" id="fact_B3"]
script = ExtResource("1_5ourl")
id = "B3"
label = "nothing in hand"
view = &"front"
place = &"hand_right"

[sub_resource type="Resource" id="fact_B4"]
script = ExtResource("1_5ourl")
id = "B4"
label = "night-shirt only, bare feet"
view = &"front"
place = &"hem"

[sub_resource type="Resource" id="mentor_1"]
script = ExtResource("2_0oklw")
text = "Read him. All of him."
highlight = Array[String](["B1", "B2", "B3", "B4", "C1", "C2", "C3", "C4"])

[sub_resource type="Resource" id="mentor_2"]
script = ExtResource("2_0oklw")
text = "His chest. His first line."
highlight = Array[String](["B1", "C1"])

[sub_resource type="Resource" id="mentor_3"]
script = ExtResource("2_0oklw")
text = "Pin them."
highlight = Array[String](["B1", "C1"])
until = 1

[sub_resource type="Resource" id="mentor_4"]
script = ExtResource("2_0oklw")
text = "Bodies don't lie. Decree II takes liars."
door = &"hel"
until = 2

[sub_resource type="Resource" id="seam_B1_C1"]
script = ExtResource("4_pcpol")
a = "B1"
b = "C1"
liar = 1
caption = "the body gives the lie."
pair_text = "No wound on his chest, and 'Danes axed my chest'"

[sub_resource type="Resource" id="seam_B4_C2"]
script = ExtResource("4_pcpol")
a = "B4"
b = "C2"
liar = 1
caption = "the body gives the lie."

[sub_resource type="Resource" id="seam_B3_C3"]
script = ExtResource("4_pcpol")
a = "B3"
b = "C3"
liar = 1
caption = "the body gives the lie."

[sub_resource type="Resource" id="seam_B3_L3"]
script = ExtResource("4_pcpol")
a = "B3"
b = "L3"
kind = 2
destination = &"hel"
caption = "Decree III sends him to Hel."

[resource]
script = ExtResource("3_pse3c")
id = &"kolbeinn"
soul_name = "Kolbeinn"
body = Array[ExtResource("1_5ourl")]([SubResource("fact_B1"), SubResource("fact_B2"), SubResource("fact_B3"), SubResource("fact_B4")])
claim = Array[String](["Danes axed my chest.", "Mail on. Shield up.", "Died sword in hand.", "My wife will tell you."])
seams = Array[ExtResource("4_pcpol")]([SubResource("seam_B1_C1"), SubResource("seam_B4_C2"), SubResource("seam_B3_C3"), SubResource("seam_B3_L3")])
legal_realm = &"hel"
worthy_realm = &"hel"
liar = true
mentor_steps = Array[ExtResource("2_0oklw")]([SubResource("mentor_1"), SubResource("mentor_2"), SubResource("mentor_3"), SubResource("mentor_4")])
truth = "Kolbeinn died in his bed after the feast, full of mead. His wife did see."
