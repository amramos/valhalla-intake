[sub_resource type="Resource" id="Resource_effuw"]
script = ExtResource("3_xr0ur")
a = "C1"
b = "L1"
kind = 2
destination = &"valhalla"
caption = "the saga is true. L1 sends him to Valhalla."

[sub_resource type="Resource" id="Resource_mentor1"]
script = ExtResource("4_mentor")
text = "Read the body first."
highlight = Array[String](["B1", "B2", "B3"])

[sub_resource type="Resource" id="Resource_mentor2"]
script = ExtResource("4_mentor")
text = "His first line. The first decree. Pin them."
highlight = Array[String](["C1", "L1"])
until = 1

[sub_resource type="Resource" id="Resource_mentor3"]
script = ExtResource("4_mentor")
text = "The Law agrees with him. Stamp him."
door = &"valhalla"
until = 2

[resource]
script = ExtResource("2_mlgv4")
id = &"ulf"
soul_name = "Ulf"
body = Array[ExtResource("1_ga5bn")]([SubResource("Resource_8k2ct"), SubResource("Resource_uxvf1"), SubResource("Resource_i307y")])
claim = Array[String](["Axed, in battle.", "Took it in the chest.", "Sword up to the end.", "Sif gets the goat now."])
seams = Array[ExtResource("3_xr0ur")]([SubResource("Resource_effuw")])
legal_realm = &"valhalla"
worthy_realm = &"valhalla"
mentor_steps = Array[ExtResource("4_mentor")]([SubResource("Resource_mentor1"), SubResource("Resource_mentor2"), SubResource("Resource_mentor3")])
truth = "Axed in the shield-wall at Ness, sword up to the end."
