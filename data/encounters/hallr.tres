[resource]
script = ExtResource("3_ju33h")
id = &"hallr"
soul_name = "Hallr"
body = Array[ExtResource("1_0w045")]([SubResource("fact_B1"), SubResource("fact_B2"), SubResource("fact_B3"), SubResource("fact_B4")])
claim = Array[String](["Gorm called me out.", "Sword still sheathed.", "Blade in my chest.", "Not a bone broken."])
